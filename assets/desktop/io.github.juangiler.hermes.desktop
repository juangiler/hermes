[Desktop Entry]
Type=Application
Name=Hermes
GenericName=File Manager
Comment=A fast, keyboard-first file manager
Exec=hermes %F
Icon=io.github.juangiler.hermes
Terminal=false
Categories=System;FileTools;FileManager;Utility;Core;
MimeType=inode/directory;
Keywords=files;folders;explorer;browser;manager;
StartupNotify=true
StartupWMClass=io.github.juangiler.hermes
